# ===========================================
# PLANTILLA DE VARIABLES DE ENTORNO - TECHNOVALD
# ===========================================
#
# Copia este archivo como .env en la raíz del proyecto y rellena los valores
# marcados como <SECRET>. El archivo .env está en .gitignore y nunca debe
# subirse al repositorio.

# ===========================================
# DOCKER
# ===========================================
# Puerto del host para la API de Docker. El IDE usa 8080 y Docker 8081.
APP_PORT=8081
# Puertos del host para inspeccionar las bases del Docker sin chocar con
# el MySQL local (3306) ni el MongoDB local (27017).
MYSQL_HOST_PORT=3307
MONGO_HOST_PORT=27018

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=technovald
MYSQL_USER=root
MYSQL_PASSWORD=<SECRET>
# Usuario no root que usará la aplicación dentro de Docker/Compose.
MYSQL_APP_USER=technovald
MYSQL_APP_PASSWORD=<SECRET>
# Contraseña del usuario root del contenedor MySQL (Docker).
MYSQL_ROOT_PASSWORD=<SECRET>

# JWT
# El secreto es la clave con la que se firman los tokens: 32 bytes aleatorios
# en Base64. En el README hay el comando para generar uno.
JWT_SECRET=<SECRET_BASE64>
JWT_EXPIRATION=86400000

# Administrador inicial. Solo se usan en el primer arranque, cuando la tabla
# usuario está vacía; después se pueden borrar del .env.
BOOTSTRAP_ADMIN_USERNAME=admin.technovald
BOOTSTRAP_ADMIN_PASSWORD=<SECRET>

# Seed de demostración (solo perfil dev; activado por defecto).
APP_SEED_ENABLED=true

# ===========================================
# MONGODB
# ===========================================

MONGO_DATABASE=technovald_catalogo
MONGO_URI=mongodb://localhost:27017/technovald_catalogo

# ===========================================
# ICECAT
# ===========================================

ICECAT_URL=https://live.icecat.biz/api/?UserName=<USUARIO>&Language=es&GTIN=
ICECAT_TOKEN=<SECRET>

# ===========================================
# GMAIL SMTP (perfil prod)
# ===========================================

GMAIL_USER=<CORREO>
GMAIL_APP_PASSWORD=<SECRET>
